%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_robo_rumbler.
%%
%% A visiting tank genome arrives over the mesh, fights the resident field of 40
%% champions, and the row is published. Version 1: no ranking, no ledger, no
%% verifier, a scratch topic.
%%
%% STORELESS AT v1, ON PURPOSE. PLAN_ROBO_RUMBLE's own tier table says an
%% embedded store "earns its place" at ranked mesh visits. There is no ranking
%% here yet, so there is no store, and the seam stays open for when there is.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The engine. A git pin rather than a hex release: robo_genome and
    %% robo_rumble are new and the pin IS the provenance of every result this
    %% service publishes, which is why the engine fingerprint travels on the wire.
    {faber_tweann,
     {git, "https://github.com/rgfaber/faber-tweann.git", {branch, "master"}}}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching faber-tweann and the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.
